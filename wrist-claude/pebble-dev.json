{
  "appName": "Wrist Assistant",
  "watchModel": "Pebble Time 2",
  "platform": "emery",
  "otherPlatforms": ["gabbro", "basalt", "chalk", "diorite", "flint"],
  "screen": "200x228, 64 colors",
  "appRamBytes": 131072,
  "sizeBudgetBytes": 63488,
  "emulatorTZ": "UTC",
  "jsTests": "test/pkjs/*.test.js",
  "otherTests": [],
  "version": {
    "scheme": "2.X.Y: X = phase in progress, Y counts app-changing PRs within it; a new phase sets X and resets Y to 0; docs-only PRs leave it alone.",
    "files": [
      { "path": "package.json", "kind": "package-json" },
      { "path": "src/pkjs/version.js", "regex": "APP_VERSION = '([0-9.]+)'" }
    ]
  },
  "github": { "bugLabel": "bug", "areaLabels": ["watch", "phone"], "publicRepo": true },
  "privateData": ["API keys", "tokens", "passwords", "personal names", "questions users asked"],
  "projectNotes": "docs/"
}
