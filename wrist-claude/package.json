  "license": "MIT",
  "version": "2.1.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Wrist Assistant",
    "uuid": "12e8fcb0-c07f-4215-994f-c5e405f093fc",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro",
      "basalt",
      "chalk",
      "diorite",
      "flint"
    ],
    "watchapp": {
