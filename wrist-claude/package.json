    "messageKeys": [
      "ASK_TEXT",
      "ASK_KIND",
      "QUICK_INDEX",
      "STATUS",
      "CHUNK",
      "CHUNK_FINAL",
      "ERROR",
      "REMINDER_TIME",
      "REMINDER_TEXT",
      "QUICK_NAMES",
      "READY",
      "APP_VERSION_KEY",
      "COMPANION",
      "ROUTE",
      "SPEAK",
      "CONFIRM_ID",
      "CONFIRM_TEXT",
      "CONFIRM_RESULT"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "MENU_ICON",
          "file": "images/menu_icon.png",
          "menuIcon": true
        }
      ]
    },
    "capabilities": [
      "configurable"
    ],
    "companionApp": {
      "android": {
        "url": "https://github.com/MrArron/Wrist-Assistant/releases",
        "apps": [
          {
            "package": "com.mrarron.wristclaude"
          }
        ]
      }
    }
  }
}
